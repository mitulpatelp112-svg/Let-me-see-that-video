# Copy this file to ".env" and fill in your values.

# --- Telegram bot (for fully-automatic absorption) ---
# 1. Open Telegram, message @BotFather, send /newbot, follow the prompts.
# 2. Paste the token it gives you here.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user ids allowed to use the bot.
# Leave empty to allow anyone (NOT recommended). Send /start to the bot to
# learn your own user id.
TELEGRAM_ALLOWED_USERS=

# --- Library ---
# Where absorbed videos and the index are stored.
LIBRARY_DIR=library

# --- What to absorb ---
# Metadata + transcript (captions) are ALWAYS absorbed. These control extras:
# Download the full video file (uses disk space).
DOWNLOAD_VIDEO=false
# Download just the audio track (handy for Whisper transcription).
DOWNLOAD_AUDIO=false
# Run local Whisper transcription when a video has no captions.
# Requires: pip install faster-whisper
TRANSCRIBE=false
WHISPER_MODEL=base

# Long-poll timeout for the Telegram bot (seconds).
POLL_TIMEOUT=50
